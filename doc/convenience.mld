{0 Convenience combinators}

Convenience combinators provide ready-to-use parsers for common patterns like
digits, numbers, letters, and whitespace.

{1 Character classes}

{2 [digit]}

{!val:Parseff.digit} parses an ASCII decimal digit, ['0'] to ['9'], and returns
it as a [char]. For the value of a number, use {!val:Parseff.integer}.

{@ocaml skip[val digit : unit -> char]}

{@ocaml[
(* Parse a two-digit number *)
let two_digits () =
  let value c = Char.code c - Char.code '0' in
  let a = Parseff.digit () in
  let b = Parseff.digit () in
  (value a * 10) + value b

(* Matches "42" -> 42 *)
]}

{2 [letter]}

{!val:Parseff.letter} parses an ASCII letter (a-z or A-Z).

{@ocaml skip[val letter : unit -> char]}

{@ocaml[
let initial () = Parseff.letter ()

(* Matches "A" -> 'A' *)
(* Matches "z" -> 'z' *)
(* Fails on "1" *)
]}

{2 [alphanum]}

{!val:Parseff.alphanum} parses an alphanumeric character (letter or digit).

{@ocaml skip[val alphanum : unit -> char]}

{@ocaml[
let username () =
  let first = Parseff.letter () in
  let rest = Parseff.many Parseff.alphanum () in
  String.make 1 first ^ String.of_seq (List.to_seq rest)

(* Matches "user123" -> "user123" *)
(* Fails on "123user" (must start with letter) *)
]}

{2 [any_char]}

{!val:Parseff.any_char} parses any character. Fails only at end of input.

{@ocaml skip[val any_char : unit -> char]}

{@ocaml[
(* Skip past a single unknown character *)
let skip_one () =
  let _ = Parseff.any_char () in
  ()

(* Peek at the next character without consuming it *)
let peek () = Parseff.look_ahead Parseff.any_char
]}

{1 Numbers}

The number parsers read a number at the current position. They stop at the first
byte that does not fit, and they work across chunk boundaries in
{!val:Parseff.parse_source}.

{2 [integer]}

{!val:Parseff.integer} parses an optional [-] and decimal digits. It fails when
the value is outside the [int] range.

{@ocaml skip[val integer : unit -> int]}

{@ocaml[
let point () =
  let x = Parseff.integer () in
  let _ = Parseff.char ',' in
  let y = Parseff.integer () in
  (x, y)

(* Matches "12,-7" -> (12, -7) *)
]}

{2 [number]}

{!val:Parseff.number} parses a number with the JSON grammar: an optional [-],
digits, an optional fraction and an optional exponent.

{@ocaml skip[val number : unit -> float]}

{@ocaml[
let coordinates () =
  let lat = Parseff.number () in
  let _ = Parseff.char ',' in
  let lon = Parseff.number () in
  (lat, lon)

(* Matches "48.85,-2.35e0" -> (48.85, -2.35) *)
]}

{2 [hex_integer]}

{!val:Parseff.hex_integer} parses hexadecimal digits. It accepts no sign and no
[0x] prefix.

{@ocaml skip[val hex_integer : unit -> int]}

{@ocaml[
let color () =
  let _ = Parseff.char '#' in
  Parseff.hex_integer ()

(* Matches "#ff8800" -> 0xff8800 *)
]}

{2 Other number formats}

The number parsers do not read a leading [+], [.5], [5.], digit separators such
as [1_000], [inf] or [nan]. An [e] or [E] after a number always starts an
exponent, so a unit such as [2em] fails.

For these formats, write your own parser with {!val:Parseff.take_while},
{!val:Parseff.recognize} and a conversion function. This one reads a number and
its unit:

{@ocaml[
let is_digit c = c >= '0' && c <= '9'
let is_letter c = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')

let quantity () =
  let text =
    Parseff.recognize (fun () ->
        let _ = Parseff.take_while ~at_least:1 ~label:"digit" is_digit in
        Parseff.optional
          (fun () ->
            let _ = Parseff.char '.' in
            Parseff.take_while ~at_least:1 ~label:"digit" is_digit)
          ())
  in
  let unit_ = Parseff.take_while ~at_least:1 ~label:"unit" is_letter in
  (float_of_string text, unit_)
]}

{@ocaml[
# Parseff.parse "2em" quantity;;
- : (float * string, Parseff.error) result = Ok (2., "em")
# Parseff.parse "1.5eV" quantity;;
- : (float * string, Parseff.error) result = Ok (1.5, "eV")
]}

{1 Whitespace}

{2 [is_whitespace]}

{!val:Parseff.is_whitespace} returns true for whitespace characters (space, tab,
newline, carriage return). This is a predicate, not a parser.

{@ocaml skip[val is_whitespace : char -> bool]}

{@ocaml[
let trim_parser () =
  Parseff.skip_while Parseff.is_whitespace;
  let value =
    Parseff.take_while ~at_least:1
      (fun c -> not (Parseff.is_whitespace c))
      ~label:"value"
  in
  Parseff.skip_while Parseff.is_whitespace;
  value

(* Matches "  hello  " -> "hello" *)
]}

{2 [whitespace]}

{!val:Parseff.whitespace} parses zero or more whitespace characters. Returns the
matched string. Always succeeds (returns empty string if no whitespace).

{@ocaml skip[val whitespace : unit -> string]}

{@ocaml[
let spaced_values () =
  let a = Parseff.digit () in
  let _ = Parseff.whitespace () in
  let b = Parseff.digit () in
  (a, b)

(* Matches "1 2" -> ('1', '2') *)
(* Matches "1    2" -> ('1', '2') *)
(* Matches "12" -> ('1', '2') *)
]}

{2 [whitespace ~at_least:1]}

{!val:Parseff.whitespace} with [~at_least:1] parses one or more whitespace
characters. Fails if no whitespace found.

{@ocaml skip[val whitespace : ?at_least:int -> unit -> string]}

{@ocaml[
let words () =
  Parseff.sep_by ~at_least:1
    (fun () ->
      Parseff.take_while ~at_least:1
        (fun c -> not (Parseff.is_whitespace c))
        ~label:"word")
    (fun () -> Parseff.whitespace ~at_least:1 ())
    ()

(* Matches "hello world" -> ["hello"; "world"] *)
(* Fails on "helloworld" (no whitespace separator) *)
]}

{2 [skip_whitespace]}

{!val:Parseff.skip_whitespace} skips zero or more whitespace characters (returns
unit). More efficient than {!val:Parseff.whitespace} when you don't need the
matched string.

{@ocaml skip[val skip_whitespace : unit -> unit]}

{@ocaml[
(* Parse comma-separated list with flexible spacing *)
let flexible_list () =
  let _ = Parseff.char '[' in
  Parseff.skip_whitespace ();
  let values =
    Parseff.sep_by
      (fun () ->
        Parseff.skip_whitespace ();
        let n = Char.code (Parseff.digit ()) - Char.code '0' in
        Parseff.skip_whitespace ();
        n)
      (fun () -> Parseff.char ',')
      ()
  in
  Parseff.skip_whitespace ();
  let _ = Parseff.char ']' in
  values

(* All of these parse to [1; 2; 3]: *)
(* "[1,2,3]" *)
(* "[ 1 , 2 , 3 ]" *)
(* "[  1  ,  2  ,  3  ]" *)
]}

{b Tip:} Always use [skip_whitespace] instead of [whitespace] when you don't
need the matched string:

{@ocaml skip[
(* allocates a string you don't need *)
let _ = Parseff.whitespace () in
parse_value ()

(* skips without allocating *)
Parseff.skip_whitespace ();
parse_value ()
]}

{1 Tokens}

{2 [lexeme]}

{!val:Parseff.lexeme} runs a parser, then [~skip], and returns the result of
the parser. [~skip] defaults to {!val:Parseff.skip_whitespace}; pass your own
when the grammar also has comments.

{@ocaml skip[val lexeme : ?skip:(unit -> unit) -> (unit -> 'a) -> 'a]}

{@ocaml[
let skip_space_and_comments () =
  Parseff.skip_whitespace ();
  while Parseff.peek_char () = Some '#' do
    Parseff.skip_while (fun c -> c <> '\n');
    Parseff.skip_whitespace ()
  done

let token p = Parseff.lexeme ~skip:skip_space_and_comments p

let pair () =
  let a = token Parseff.digit in
  let _ = token (fun () -> Parseff.char ',') in
  let b = token Parseff.digit in
  (a, b)

(* Matches "1 , 2" -> ('1', '2') *)
(* Matches "1 # first\n, 2" -> ('1', '2') *)
]}

{2 [keyword]}

{!val:Parseff.keyword} matches a literal only when the next byte cannot
continue an identifier, so that ["let"] does not match the start of
["letter"]. Pass [~is_ident] to change which bytes continue an identifier. In
streaming, [keyword] needs a backtrack window of one byte more than the
keyword.

{@ocaml skip[val keyword : ?is_ident:(char -> bool) -> string -> unit]}

{@ocaml[
let binding () =
  Parseff.keyword "let";
  Parseff.skip_whitespace ();
  Parseff.take_while ~at_least:1 (fun c -> c >= 'a' && c <= 'z') ~label:"name"

(* Matches "let x" -> "x" *)
(* Fails on "letter x" at offset 0, expecting "let" *)
]}
