{0 Comparison with Angstrom}

How Parseff compares to {{:https://github.com/inhabitedtype/angstrom}Angstrom}
in performance, API style, and trade-offs.

{1 Performance}

Cross-library workloads in
{{:https://github.com/davesnx/parseff/tree/main/bench}[bench/]}:

{v
Benchmark    Best Parseff result   What it measures
JSON         ~2.47M/s optimized    Full JSON array parser vs Angstrom
CSV          ~3.93M/s fused        CSV field parser vs Angstrom and MParser
Arithmetic   ~11.86M/s fused       Expression evaluator vs Angstrom and MParser
v}

{2 JSON benchmark}

JSON array parser ([[1, 2, 3, ..., 10]]) over 1,000,000 iterations (3 runs).
Source:
{{:https://github.com/davesnx/parseff/blob/main/bench/bench_json.ml}[bench/bench_json.ml]}.

{v
                        Parses/sec     vs. Angstrom (generic)   Minor allocs
Parseff (optimized)     ~2,470,000     2.0x faster              1.5 GB
Parseff (generic)       ~1,740,000     1.4x faster              1.1 GB
Angstrom (optimized)    ~1,720,000     1.4x faster             11.1 GB
Angstrom (generic)      ~1,260,000     baseline                 5.9 GB
v}

- {b Optimized}: {!val:Parseff.Slice.sep_by_take} plus [List.map] (avoids
  per-element [String.sub] during scanning; still converts with
  [float_of_string] via {!val:Parseff.Slice.to_string}).
- {b Generic}: ordinary [char], [skip_while], [take_while], and [sep_by] with
  the same [float_of_string] conversion as [Angstrom (generic)].
- Minor allocations are cumulative [Benchmark.latencyN] totals across all
  1,000,000 parses.

{2 Other cross-library benchmarks}

{v
            Parseff best   Parseff generic   Angstrom best   MParser
CSV         ~3,930,000     ~2,790,000        ~2,550,000      ~1,490,000
Arithmetic  ~11,860,000    ~2,960,000        ~5,360,000      ~1,510,000
v}

{2 Why Parseff is faster}

- {b Direct character scanning}: {!val:Parseff.take_while} runs a tight loop
  over the input buffer (optionally backed by a {!module:Parseff.Charset} table).
- {b Zero-copy slices}: {!module:Parseff.Slice} avoids per-token [String.sub]
  allocations.
- {b Fused scanners}: {!val:Parseff.Slice.sep_by_take} scans a separated list
  in one loop without chaining monadic closures.
- {b Direct-style calls}: sequencing uses plain OCaml function calls rather
  than CPS closures.

{1 API style}

Parseff uses direct-style OCaml functions ([unit -> 'a]); Angstrom uses monadic
and applicative combinators.

{2 Sequencing}

{b Parseff:}

{@ocaml skip[
let key_value () =
  let key = Parseff.take_while ~at_least:1 ~label:"key" (fun c -> c <> ':') in
  let _ = Parseff.char ':' in
  Parseff.skip_whitespace ();
  let value =
    Parseff.take_while ~at_least:1 ~label:"value" (fun c -> c <> '\n')
  in
  (key, value)
]}

{b Angstrom:}

{@ocaml skip[
let key_value =
  take_while1 (fun c -> c <> ':') >>= fun key ->
  char ':' >>= fun _ ->
  skip_while is_ws >>= fun () ->
  take_while1 (fun c -> c <> '\n') >>= fun value ->
  return (key, value)
]}

{2 Alternation and repetition}

{b Parseff:}

{@ocaml skip[
let value () =
  Parseff.one_of [ null_parser; bool_parser; number_parser; string_parser ]

let numbers () =
  Parseff.sep_by
    (fun () ->
      Parseff.skip_whitespace ();
      let s = Parseff.take_while ~at_least:1 ~label:"digit" is_digit in
      Parseff.skip_whitespace ();
      int_of_string s)
    (fun () -> Parseff.char ',')
]}

{b Angstrom:}

{@ocaml skip[
let value =
  null_parser <|> bool_parser <|> number_parser <|> string_parser

let numbers =
  sep_by (ws *> char ',' <* ws)
    (take_while1 is_digit >>| int_of_string)
]}

{2 Side-by-side expression parser}

{b Parseff:}

{@ocaml skip[
let rec expr () =
  Parseff.fold_left term (fun () ->
      Parseff.skip_whitespace ();
      let _ = Parseff.char '+' in
      Parseff.skip_whitespace ();
      ( + ))

and term () =
  Parseff.fold_left factor (fun () ->
      Parseff.skip_whitespace ();
      let _ = Parseff.char '*' in
      Parseff.skip_whitespace ();
      ( * ))

and factor () =
  Parseff.or_
    (fun () ->
      let _ = Parseff.char '(' in
      let e = Parseff.rec_ expr in
      let _ = Parseff.char ')' in
      e)
    (fun () -> Char.code (Parseff.digit ()) - Char.code '0')
]}

{b Angstrom:}

{@ocaml skip[
let expr =
  fix (fun expr ->
    let factor =
      char '(' *> expr <* char ')'
      <|> (satisfy is_digit >>| fun c -> Char.code c - 48)
    in
    let term = chainl1 factor (ws *> char '*' <* ws >>| fun _ -> ( * )) in
    chainl1 term (ws *> char '+' <* ws >>| fun _ -> ( + )))
]}

{1 Feature comparison}

{table
  {tr
    {th Feature}
    {th Parseff}
    {th Angstrom}}
  {tr
    {td OCaml version}
    {td 5.3+}
    {td 4.x+}}
  {tr
    {td API style}
    {td Direct style}
    {td Monadic (CPS)}}
  {tr
    {td Pull streaming}
    {td [Source.parse], [Source.parse_each]}
    {td Buffered / Unbuffered}}
  {tr
    {td Push / async}
    {td [Push.parse], [Push.parse_each]; Eio fibers via [Source]}
    {td Incremental [Partial] API}}
  {tr
    {td Backtracking}
    {td Automatic via [or_]; bounded window in streaming}
    {td Automatic via [<|>]; unbounded buffer}}
  {tr
    {td Zero-copy}
    {td [Slice.t] + fused scanners}
    {td [Unsafe] / bigstring slices}}
  {tr
    {td Recursion safety}
    {td [rec_] with [~max_depth]}
    {td Manual}}
  {tr
    {td Custom errors}
    {td Extensible [custom_error], diagnostics, recovery}
    {td String-based}}
  {tr
    {td Error labels}
    {td [expect], [one_of_labeled], [context]}
    {td [<?>]} }
  {tr
    {td Maturity}
    {td New}
    {td Battle-tested, widely used}}}

