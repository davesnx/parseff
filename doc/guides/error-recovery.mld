{0 Guide: Error recovery}

Report every error in the input, not only the first.

A parse stops at the first error. This guide uses {!val:Parseff.capture} and
{!val:Parseff.recover} to report every error, and to build a tree with holes
where the broken parts were.

{1 A statement list}

The input is a list of statements such as [let x = 1;]. {!val:Parseff.cut}
after [let] says that the statement is decided:

{@ocaml[
type stmt = Let of string * int | Hole

let ws () = Parseff.skip_whitespace ()

let ident () =
  Parseff.take_while ~at_least:1 ~label:"identifier" (fun c ->
      c >= 'a' && c <= 'z')

let integer () =
  int_of_string
    (Parseff.take_while ~at_least:1 ~label:"integer" (fun c ->
         c >= '0' && c <= '9'))

let statement () =
  Parseff.context "statement" (fun () ->
      let _ = Parseff.consume "let" in
      Parseff.cut ();
      ws ();
      let name = ident () in
      ws ();
      let _ = Parseff.char '=' in
      ws ();
      let value = integer () in
      ws ();
      let _ = Parseff.char ';' in
      Let (name, value))

let program body () =
  let stmts =
    Parseff.many
      (fun () ->
        ws ();
        body ())
      ()
  in
  ws ();
  stmts

let input = "let x = 1; let y = ; let z = 3; let = 4;"
]}

Without recovery, the parse reports only the first of the two broken
statements:

{@ocaml[
# match Parseff.parse input (program statement) with
  | Ok _ -> ()
  | Error e -> print_endline (Parseff.render_error ~source:input e);;
1:20: [error] expected integer, found ';'
1 | let x = 1; let y = ; let z = 3; let = 4;
  |                    ^
  * while parsing statement, from 1:12
- : unit = ()
]}

{1 [capture]}

{@ocaml skip[val capture : (unit -> 'a) -> ('a, error) result]}

{!val:Parseff.capture} runs a parser and returns its failure as a value. On a
failure, the position goes back to where [capture] started. Unlike
{!val:Parseff.or_}, [capture] also catches the failure of a statement that
[cut] decided:

{@ocaml[
# Parseff.parse "let y = ;" (fun () ->
    Parseff.or_ statement (fun () -> Hole) ())
  |> Result.map_error Parseff.error_message;;
- : (stmt, string) result = Error "expected integer, found ';'"
# Parseff.parse ~consume:`Partial "let y = ;" (fun () ->
    match Parseff.capture statement with
    | Ok _ -> "ok"
    | Error e ->
        Printf.sprintf "%s, back at %d" (Parseff.error_message e)
          (Parseff.position ()));;
- : (string, Parseff.error) result =
Ok "expected integer, found ';', back at 0"
]}

{1 [recover]}

{@ocaml skip[val recover :
  error Diagnostics.t ->
  sync:(unit -> unit) ->
  (unit -> 'a) ->
  (error -> 'a) ->
  'a]}

[recover errors ~sync parser hole] runs [parser] with [capture]. On a failure
[e], it records [e] in [errors], calls [sync ()] to skip to where parsing can
continue, and returns [hole e]. Pass the same collector to the runner with
[~diagnostics]:

{@ocaml[
let skip_statement () =
  Parseff.skip_while (fun c -> c <> ';');
  ignore (Parseff.optional (fun () -> Parseff.char ';') ())

let statements errors =
  program (fun () ->
      Parseff.recover errors ~sync:skip_statement statement (fun _ -> Hole))

let show = function
  | Let (name, value) -> Printf.sprintf "%s = %d" name value
  | Hole -> "<hole>"

let run parser input =
  let errors = Parseff.Diagnostics.create () in
  (match Parseff.parse ~diagnostics:errors input (parser errors) with
  | Ok stmts -> print_endline (String.concat "; " (List.map show stmts))
  | Error e -> print_endline (Parseff.render_error ~source:input e));
  List.iter
    (fun { Parseff.Diagnostics.value = e; _ } ->
      print_endline (Parseff.render_error ~source:input e))
    (Parseff.Diagnostics.to_list errors)
]}

The parse now succeeds, with a hole for each broken statement and both errors:

{@ocaml[
# run statements input;;
x = 1; <hole>; z = 3; <hole>
1:20: [error] expected integer, found ';'
1 | let x = 1; let y = ; let z = 3; let = 4;
  |                    ^
  * while parsing statement, from 1:12
1:37: [error] expected identifier, found '='
1 | let x = 1; let y = ; let z = 3; let = 4;
  |                                     ^
  * while parsing statement, from 1:33
- : unit = ()
]}

{1 Choosing a sync point}

[sync] decides where parsing continues. A good sync point is a token that ends
the broken construct. For a statement it is the [;], and [skip_statement] consumes it.

In a list, the [,] or [\]] after an element belongs to the list, so the skip
must stop before it. Use [capture] here, not [recover]: a hole can be empty, as
in [\[1, , 3\]], and [recover] always consumes input. At the end of the input,
call the element parser directly, as [recover] does. Every element now
succeeds, so check for [\]] with {!val:Parseff.look_ahead} first. If lists can
nest, count the brackets as you skip.

{@ocaml[
let array errors () =
  Parseff.context ~delimited:true "array" (fun () ->
      let _ = Parseff.char '[' in
      ws ();
      let xs =
        Parseff.or_
          (fun () ->
            let _ = Parseff.look_ahead (fun () -> Parseff.char ']') in
            [])
          (Parseff.sep_by
             (fun () ->
               if Parseff.peek_char () = None then Some (integer ())
               else
                 match Parseff.capture (fun () -> Some (integer ())) with
                 | Ok x -> x
                 | Error e ->
                     Parseff.warn ~pos:e.range.start errors e;
                     Parseff.skip_while (fun c -> c <> ',' && c <> ']');
                     None)
             (fun () ->
               ws ();
               let _ = Parseff.char ',' in
               ws ()))
          ()
      in
      ws ();
      let _ = Parseff.char ']' in
      xs)

let run_array input =
  let errors = Parseff.Diagnostics.create () in
  (match Parseff.parse ~diagnostics:errors input (array errors) with
  | Ok xs ->
      print_endline
        (String.concat "; "
           (List.map (function Some n -> string_of_int n | None -> "<hole>") xs))
  | Error e -> print_endline (Parseff.render_error ~source:input e));
  List.iter
    (fun { Parseff.Diagnostics.value = e; _ } ->
      print_endline (Parseff.render_error ~source:input e))
    (Parseff.Diagnostics.to_list errors)
]}

{@ocaml[
# run_array "[1, ?, 3, @]";;
1; <hole>; 3; <hole>
1:5: [error] expected integer, found '?'
1 | [1, ?, 3, @]
  |     ^
  * while parsing array, from 1:1
1:11: [error] expected integer, found '@'
1 | [1, ?, 3, @]
  |           ^
  * while parsing array, from 1:1
- : unit = ()
# run_array "[1, , 3]";;
1; <hole>; 3
1:5: [error] expected integer, found ','
1 | [1, , 3]
  |     ^
  * while parsing array, from 1:1
- : unit = ()
# run_array "[]";;
- : unit = ()
# run_array "[1,]";;
1; <hole>
1:4: [error] expected integer, found ']'
1 | [1,]
  |    ^
  * while parsing array, from 1:1
- : unit = ()
# run_array "[1, ";;
1:5: [error] expected integer, found end of input
1 | [1,
  |     ^
  * while parsing array, from 1:1
- : unit = ()
]}

{1 A list with a closing token}

Inside {!val:Parseff.many}, [recover] would read the [}] of a block as a broken
statement and skip it. Stop the loop at the closing token before you call
[recover], and make [sync] stop before that token too:

{@ocaml[
let skip_in_block () =
  Parseff.skip_while (fun c -> c <> ';' && c <> '}');
  ignore (Parseff.optional (fun () -> Parseff.char ';') ())

let block errors () =
  let _ = Parseff.char '{' in
  let stmts =
    Parseff.many
      (fun () ->
        ws ();
        let _ =
          Parseff.look_ahead (fun () ->
              Parseff.satisfy ~label:"statement" (fun c -> c <> '}'))
        in
        Parseff.recover errors ~sync:skip_in_block statement (fun _ -> Hole))
      ()
  in
  ws ();
  let _ = Parseff.char '}' in
  stmts
]}

A valid block gives the same result as without recovery:

{@ocaml[
# run block "{ let x = 1; }";;
x = 1
- : unit = ()
# run block "{ let x = ; let y = 2; }";;
<hole>; y = 2
1:11: [error] expected integer, found ';'
1 | { let x = ; let y = 2; }
  |           ^
  * while parsing statement, from 1:3
- : unit = ()
# run block "{ let x = 1 }";;
<hole>
1:13: [error] expected ';', found '}'
1 | { let x = 1 }
  |             ^
  * while parsing statement, from 1:3
- : unit = ()
# run block "{ }";;
- : unit = ()
]}

{1 Limits}

{b [recover] always consumes input.} Here [sync] does nothing, and [recover]
skips the [;] where the second statement failed. To continue without consuming
input, use [capture].

{@ocaml[
# let errors = Parseff.Diagnostics.create () in
  Parseff.parse ~diagnostics:errors "let x = 1; let y = ; let z = 3;"
    (program (fun () ->
         Parseff.recover errors ~sync:(fun () -> ()) statement (fun _ -> Hole)))
  |> Result.map (List.map show);;
- : (string list, Parseff.error) result = Ok ["x = 1"; "<hole>"; "z = 3"]
]}

{b At the end of the input, [recover] does not recover.} The parse fails as it
would without [recover]:

{@ocaml[
# let errors = Parseff.Diagnostics.create () in
  let sum () =
    let a = integer () in
    ws ();
    let _ = Parseff.char '+' in
    ws ();
    a + Parseff.recover errors ~sync:(fun () -> ()) integer (fun _ -> 0)
  in
  let r = Parseff.parse ~diagnostics:errors "1 +" sum in
  (Result.map_error Parseff.error_message r, Parseff.Diagnostics.length errors);;
- : (int, string) result * int =
(Error "expected integer, found end of input", 0)
]}

{b [recover] keeps only the error of the parser.} The errors that the parser
recorded before it failed are removed, such as an [unfinished string] that
then makes the statement fail. To keep them, pass [~record:(fun e inner -> ...)]:
it replaces the recording of [e], and [inner] holds the removed errors.

{b A recovered error keeps the contexts around [recover].} Inside a
[context ~delimited:true], {!val:Parseff.render_error} shows the whole
enclosing construct for each recovered error. Pass [~outer:false] to keep only
the contexts that the parser opened.

{b The collector must be the one given to the runner.} Otherwise [recover]
raises [Invalid_argument]:

{@ocaml[
# Parseff.parse input (statements (Parseff.Diagnostics.create ()));;
Exception:
Invalid_argument
 "Parseff.recover: errors is not the collector given to the runner".
]}

{b In streaming, [capture] keeps its input.} A construct longer than
[~backtrack_window] fails with [Backtrack_window_exceeded].
