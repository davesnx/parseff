{0 Primitives}

Primitives read bytes directly from the input.

{1 String and character matching}

{2 [literal]}

{!val:Parseff.literal} matches an exact string and returns [()]. On a mismatch,
it fails at the first differing byte expecting the rest of the string:
[literal "ab"] on ["ax"] fails at offset 1 with [expected "b"]. Mismatches
inside a multi-byte UTF-8 character are reported at the start of that
character. Pass [~case_sensitive:false] for ASCII case-insensitive matching
([A]–[Z] and [a]–[z] only).

{@ocaml skip[val literal : ?case_sensitive:bool -> string -> unit]}

{@ocaml[
let greeting () =
  Parseff.literal ~case_sensitive:false "hello ";
  Parseff.literal "world"
]}

In streaming, [literal] checks buffered bytes first and pulls more input only
while the prefix matches, so a wrong byte fails immediately without waiting for
the rest of the literal.

{2 [char]}

{!val:Parseff.char} matches a single byte and returns it.

{@ocaml skip[val char : char -> char]}

{@ocaml[
let pair () =
  let _ = Parseff.char '(' in
  let a = Parseff.digit () in
  let _ = Parseff.char ',' in
  let b = Parseff.digit () in
  let _ = Parseff.char ')' in
  (a, b)
]}

{2 [satisfy]}

{!val:Parseff.satisfy} matches one byte satisfying a predicate. [~label] names
the expectation in error messages (default: ["matching character"]).

{@ocaml skip[val satisfy : ?label:string -> (char -> bool) -> char]}

{@ocaml[
let vowel () =
  Parseff.satisfy ~label:"vowel" (fun c -> String.contains "aeiouAEIOU" c)

let uppercase () =
  Parseff.satisfy ~label:"uppercase letter" (fun c -> c >= 'A' && c <= 'Z')
]}

{2 [peek_char]}

{!val:Parseff.peek_char} returns [Some c] for the next byte without consuming
it, or [None] at end of input. Use it for cheap single-byte dispatch instead of
trying alternatives with {!val:Parseff.or_}.

{@ocaml skip[val peek_char : unit -> char option]}

{@ocaml[
let value_start () =
  match Parseff.peek_char () with
  | Some '[' -> `Array
  | Some '{' -> `Object
  | Some '"' -> `String
  | _ -> Parseff.fail "expected value"
]}

{1 Character scanning}

{2 [take_while] and [skip_while]}

{!val:Parseff.take_while} consumes bytes while a predicate holds and returns
them as a string. {!val:Parseff.skip_while} does the same without allocating.

{@ocaml skip[
val take_while :
  ?at_least:int -> ?at_most:int -> ?label:string -> ?set:Charset.t ->
  (char -> bool) -> string

val skip_while : ?set:Charset.t -> (char -> bool) -> unit
]}

- [~at_least] requires at least that many matching bytes, failing with [~label]
  (default: ["at least n characters"]) if fewer match.
- [~at_most] caps the byte count (unstable: may change in any minor release), failing with
  [Limit_exceeded { limit = at_most }] if another matching byte follows.
- [~set] replaces per-byte predicate calls with a precomputed {!module:Parseff.Charset}
  lookup table.

{@ocaml[
let digits () =
  Parseff.take_while ~at_least:1 ~label:"digit" (fun c -> c >= '0' && c <= '9')

let csv_field () =
  Parseff.skip_while (fun c -> c = ' ');
  let value = Parseff.take_while (fun c -> c <> ',' && c <> '\n') in
  Parseff.skip_while (fun c -> c = ' ');
  value
]}

{2 [Charset]}

{!module:Parseff.Charset} builds a 256-byte lookup table once outside your
parser so {!val:Parseff.take_while}, {!val:Parseff.skip_while},
{!val:Parseff.Slice.take_while}, and {!val:Parseff.take_while_iter} avoid
calling an OCaml predicate closure per byte.

{@ocaml skip[
module Charset : sig
  type t
  val of_predicate : (char -> bool) -> t
  val mem : t -> char -> bool
end
]}

{@ocaml[
let is_digit c = c >= '0' && c <= '9'
let digit_set = Parseff.Charset.of_predicate is_digit

let fast_digits () =
  Parseff.take_while ~at_least:1 ~label:"digit" ~set:digit_set is_digit
]}

{2 [take_until] and [skip_until]}

{!val:Parseff.take_until} reads all bytes before the first occurrence of a
terminator string without consuming the terminator. {!val:Parseff.skip_until}
skips them without allocating. Both fail at end of input with
[expected "<terminator>"] (or [~label]) if the terminator never appears, and
support [~at_most] (unstable).

{@ocaml skip[
val take_until : ?at_most:int -> ?label:string -> string -> string
val skip_until : ?at_most:int -> ?label:string -> string -> unit
]}

{@ocaml[
let block_comment () =
  Parseff.literal "/*";
  let body = Parseff.take_until "*/" in
  Parseff.literal "*/";
  body
]}

In streaming, [skip_until] retains only the last
[String.length terminator - 1] bytes, so it can skip past text longer than
[~backtrack_window]; [take_until] must hold its entire result in the window.

{1 Input bounds and positions}

{2 [end_of_input]}

{!val:Parseff.end_of_input} succeeds only when no input remains.
{!val:Parseff.parse} and {!val:Parseff.Source.parse} enforce this by default
unless [~consume:`Partial] is passed, so top-level parsers rarely need it.

{@ocaml skip[val end_of_input : unit -> unit]}

{2 [position], [with_range], and [location]}

- {!val:Parseff.position} returns the current byte offset from the start of the
  input.
- {!val:Parseff.with_range} runs a parser and returns its result alongside the
  {!type:Parseff.range} of bytes it consumed.
- {!val:Parseff.location} returns a 1-based {!type:Parseff.location} record
  ([byte_col] counts bytes, not Unicode code points). The line index is built
  lazily on first call. Outside a parser, use {!val:Parseff.location_of_position}.

{@ocaml skip[
type range = { start : int; stop : int }
type location = private { offset : int; line : int; byte_col : int }

val position : unit -> int
val with_range : (unit -> 'a) -> 'a * range
val location : unit -> location
val location_of_position : string -> int -> location
]}

{@ocaml[
let octet () =
  let n, range =
    Parseff.with_range (fun () ->
        int_of_string
          (Parseff.take_while ~at_least:1 ~label:"digit" (fun c ->
               c >= '0' && c <= '9')))
  in
  if n > 255 then
    Parseff.fail
      ~notes:[ { Parseff.at = Some range; text = "octets are 0 to 255" } ]
      "octet out of range";
  n

let report_error input = function
  | Error e ->
      let loc = Parseff.location_of_position input e.Parseff.range.start in
      Printf.printf "line %d, byte %d: %s\n" loc.line loc.byte_col
        (Parseff.error_message e)
  | Ok _ -> ()
]}

{2 [recognize] and [Slice.recognize]}

{!val:Parseff.recognize} runs a parser, discards its result, and returns the
consumed input bytes as a string. {!val:Parseff.Slice.recognize} returns a
zero-copy {!type:Parseff.Slice.t}.

{@ocaml skip[
val recognize : (unit -> 'a) -> string
val Slice.recognize : (unit -> 'a) -> Slice.t
]}

{@ocaml[
let ident () =
  Parseff.recognize (fun () ->
      let _ = Parseff.letter () in
      let _ =
        Parseff.many (fun () ->
            Parseff.or_ Parseff.alphanum (fun () -> Parseff.char '_'))
      in
      ())

let () =
  match Parseff.parse ~consume:`Partial "foo_1 = 2" ident with
  | Ok name -> assert (name = "foo_1")
  | Error _ -> assert false
]}

{2 Failure primitives}

For {!val:Parseff.fail}, {!val:Parseff.error}, and {!val:Parseff.expect}, see
{!page:errors}.
