{0 Diagnostics}

Use diagnostics when you want to keep parsing and report multiple validation
problems instead of stopping at the first one.

To collect parse errors and continue after them, see the
{{:https://davesnx.github.io/parseff/guides/error-recovery/}Error recovery}
guide.

{1 Types}

{@ocaml skip[
type severity = [ `Error | `Warning ]

module Diagnostics : sig
  type entry = { pos : int; value : error }
  type t
  val create : unit -> t
  val to_list : t -> entry list
  val length : t -> int
  val is_empty : t -> bool
  val clear : t -> unit
end
]}

A {!type:Parseff.Diagnostics.t} collects the diagnostics of one parse. Each
entry holds an {!type:Parseff.error} and its start position. The [severity]
field of the error tells a warning from an error:

- [`Warning]: a diagnostic from {!val:Parseff.warn}.
- [`Error]: an error that {!val:Parseff.recover}, {!val:Parseff.require} or
  {!val:Parseff.list} recorded before the parse continued. A failed parse
  returns an [`Error] too.

{1 Emitting diagnostics}

{@ocaml skip[val warn :
  ?from:int ->
  ?upto:int ->
  ?notes:note list ->
  ?help:string ->
  custom_error ->
  unit]}

{!val:Parseff.warn} works as {!val:Parseff.error}, but records the error and
continues parsing. Declare the cases of {!type:Parseff.custom_error} for your
warnings. The warning covers the current position, or the bytes from [~from]
to [~upto], with the same rules as {!val:Parseff.fail}. [~notes] and [~help]
are kept in the error, and {!val:Parseff.render_error} prints them.

{1 Collecting diagnostics}

Create a collector and pass it to the runner with [~diagnostics]. The runner
empties it first. {!val:Parseff.warn} records into that collector. When the
runner got no collector, [warn] records nothing. [recover], [require] and
[list] take the collector as an argument, and recover only with the collector
that the runner got.

The result of the parse is the usual {!type:Parseff.error} result. Read the
diagnostics from the collector after the parse. They are there for [Ok] and for
[Error].

{@ocaml skip[val parse :
  ?max_depth:int ->
  ?consume:[ `All | `Partial ] ->
  ?diagnostics:Diagnostics.t ->
  ?trace:(trace_event -> unit) ->
  string ->
  (unit -> 'a) ->
  ('a, error) Stdlib.result]}

{@ocaml skip[Parseff.parse input parser]}

By default the parse requires that all input is consumed. It is the same as
calling {!val:Parseff.end_of_input} once more at the end of your parser. It does
not change how explicit {!val:Parseff.end_of_input} calls behave inside your
parser. Pass [~consume:`Partial] to let the parse stop before the end of the
input.
{!val:Parseff.parse_source} takes the same arguments.

{1 Example}

{@ocaml[
type Parseff.custom_error += Octet_out_of_range of int

let number_lenient () =
  let start = Parseff.position () in
  let digits = Parseff.many ~at_least:1 Parseff.digit () in
  let value d = Char.code d - Char.code '0' in
  let n = List.fold_left (fun acc d -> (acc * 10) + value d) 0 digits in
  if n > 255 then Parseff.warn ~from:start (Octet_out_of_range n);
  n

let ip_address_lenient () =
  let a = number_lenient () in
  let _ = Parseff.char '.' in
  let b = number_lenient () in
  let _ = Parseff.char '.' in
  let c = number_lenient () in
  let _ = Parseff.char '.' in
  let d = number_lenient () in
  (a, b, c, d)

let custom = function
  | Octet_out_of_range n -> Printf.sprintf "octet %d out of range (0-255)" n
  | _ -> "unknown"

let report input =
  let diagnostics = Parseff.Diagnostics.create () in
  let outcome = Parseff.parse ~diagnostics input ip_address_lenient in
  (match outcome with
  | Ok (a, b, c, d) -> Printf.printf "Parsed: %d.%d.%d.%d\n" a b c d
  | Error error ->
      Printf.printf "Parse error at %d: %s\n" error.range.start
        (Parseff.error_message error));
  List.iter
    (fun ({ value; _ } : Parseff.Diagnostics.entry) ->
      print_endline
        (Parseff.render_error ~name:"ip" ~source:input ~custom value))
    (Parseff.Diagnostics.to_list diagnostics)
]}

The parse succeeds, and each octet out of range gives a warning:

{@ocaml[
# report "999.2.3.256";;
Parsed: 999.2.3.256
ip:1:1: [warning] octet 999 out of range (0-255)
1 | 999.2.3.256
  | ^^^
ip:1:9: [warning] octet 256 out of range (0-255)
1 | 999.2.3.256
  |         ^^^
- : unit = ()
]}

To react to one warning, match the [kind] and the [severity] of the entry:

{@ocaml[
let octets_out_of_range diagnostics =
  List.filter_map
    (fun ({ value; _ } : Parseff.Diagnostics.entry) ->
      match value with
      | { severity = `Warning; kind = Custom (Octet_out_of_range n); _ } ->
          Some n
      | _ -> None)
    (Parseff.Diagnostics.to_list diagnostics)
]}

{1 Backtracking semantics}

Diagnostics are transactional with parser control flow:

- {!val:Parseff.or_}: diagnostics from failed branches are rolled back
- {!val:Parseff.many}: diagnostics from the final failing attempt are rolled
  back
- {!val:Parseff.look_ahead} and {!val:Parseff.peek_with}: diagnostics are
  rolled back
- {!val:Parseff.capture} and {!val:Parseff.recover}: when the parser inside
  fails, the warnings and errors that it recorded are rolled back. [recover]
  records the error of the parser in their place. To keep them, pass [~keep] to
  [recover]; see the {{!page-"error-recovery"}error recovery guide}

This prevents diagnostics from leaking out of speculative branches.

{1 Ref}

A {!type:Parseff.Ref.t} is a [ref] whose changes are undone when the parser
backtracks, in the same cases as diagnostics. Use it for state that the parser
builds as it reads, such as a symbol table. Only the value in the cell is
restored, so store immutable values.

{@ocaml skip[
module Ref : sig
  type 'a t
  val create : 'a -> 'a t
  val get : 'a t -> 'a
  val set : 'a t -> 'a -> unit
end
]}

In this example both branches of [statement] call [declare], and the first
branch fails on [;]. The plain [ref] keeps the name of the failed branch. The
{!type:Parseff.Ref.t} does not.

{@ocaml[
let plain = ref []
let names = Parseff.Ref.create []

let declare () =
  let name =
    Parseff.take_while ~at_least:1 (fun c -> c >= 'a' && c <= 'z')
  in
  plain := name :: !plain;
  Parseff.Ref.set names (name :: Parseff.Ref.get names)

let statement () =
  Parseff.or_
    (fun () ->
      declare ();
      let _ = Parseff.char '=' in
      `Assign)
    (fun () ->
      declare ();
      let _ = Parseff.char ';' in
      `Declare)
    ()

let () =
  plain := [];
  Parseff.Ref.set names [];
  match Parseff.parse "abc;" statement with
  | Ok `Declare ->
      assert (!plain = [ "abc"; "abc" ]);
      assert (Parseff.Ref.get names = [ "abc" ])
  | _ -> assert false
]}
