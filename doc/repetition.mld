{0 Repetition and separation}

Combinators for repeated items, separated lists, delimited blocks, streaming
iteration, and operator-precedence expressions.

{1 Basic repetition}

{2 [many]}

{!val:Parseff.many} runs a parser repeatedly until it fails or an iteration
consumes no input (dropping that zero-width result), returning the matched list.

{@ocaml skip[val many : ?at_least:int -> ?at_most:int -> (unit -> 'a) -> 'a list]}

- [~at_least] requires at least that many matches.
- [~at_most] caps the count (unstable: may change in 1.x), failing with
  [Limit_exceeded { limit = at_most }] if another match consumes input.

{@ocaml[
let digits () = Parseff.many Parseff.digit
let digits1 () = Parseff.many ~at_least:1 Parseff.digit
]}

{2 [count]}

{!val:Parseff.count} runs a parser exactly [n] times, failing if any repetition
fails.

{@ocaml skip[val count : int -> (unit -> 'a) -> 'a list]}

{@ocaml[
let hex_digit () =
  Parseff.satisfy ~label:"hex digit" (fun c ->
      (c >= '0' && c <= '9')
      || (c >= 'a' && c <= 'f')
      || (c >= 'A' && c <= 'F'))

let hex_color () =
  let _ = Parseff.char '#' in
  let r = Parseff.count 2 hex_digit in
  let g = Parseff.count 2 hex_digit in
  let b = Parseff.count 2 hex_digit in
  (r, g, b)
]}

{2 Errors at the end of a loop}

The failure that stops a repetition loop is still recorded for furthest-failure
reporting. On ["12x"], [many digit] stops at ['x'] and a following
[end_of_input] fails at the same offset, producing
[expected digit or end of input]. If a loop stops partway through an element
(such as ["ab,ab,ax"] for [sep_by (fun () -> literal "ab") (fun () -> char ',')]),
the deeper failure ([expected "b"] at offset 7) wins over [end_of_input] at
offset 5.

{1 Separated and delimited lists}

{2 [sep_by] and [end_by]}

{!val:Parseff.sep_by} parses zero or more elements separated by a separator
(discarding separator results). {!val:Parseff.end_by} expects the separator
{e after} every element, including the last. Pass [~at_least:1] to require at
least one element; both stop on zero-width steps.

{@ocaml skip[
val sep_by : ?at_least:int -> (unit -> 'a) -> (unit -> 'b) -> 'a list
val end_by : ?at_least:int -> (unit -> 'a) -> (unit -> 'b) -> 'a list
]}

{@ocaml[
let csv_line () =
  Parseff.sep_by ~at_least:1
    (fun () ->
      Parseff.take_while ~at_least:1 ~label:"value" (fun c ->
          c <> ',' && c <> '\n'))
    (fun () -> Parseff.char ',')

let statements () =
  Parseff.end_by
    (fun () ->
      Parseff.take_while ~at_least:1 ~label:"statement" (fun c ->
          c <> ';' && c <> '\n'))
    (fun () -> Parseff.char ';')
]}

{2 [between]}

{!val:Parseff.between} parses an opening delimiter, a body, and a closing
delimiter, returning the body's result.

{@ocaml skip[val between : (unit -> 'a) -> (unit -> 'b) -> (unit -> 'c) -> 'c]}

{@ocaml[
let parens p =
  Parseff.between (fun () -> Parseff.char '(') (fun () -> Parseff.char ')') p

let brackets p =
  Parseff.between (fun () -> Parseff.char '[') (fun () -> Parseff.char ']') p
]}

{1 Streaming iteration}

{2 [many_iter] and [sep_by_iter]}

{!val:Parseff.many_iter} and {!val:Parseff.sep_by_iter} (unstable: may change
in 1.x) behave like [many] and [sep_by] without building a list, passing each
parsed element directly to a callback [f].

{@ocaml skip[
val many_iter : ?at_least:int -> (unit -> 'a) -> ('a -> unit) -> unit
val sep_by_iter :
  ?at_least:int -> (unit -> 'a) -> (unit -> 'b) -> ('a -> unit) -> unit
]}

Before each callback call, they seal every open backtracking frame so streaming
sources can drop earlier bytes and keep memory bounded by one element. Calling
them inside frames that cannot be sealed (such as {!val:Parseff.look_ahead} or
{!val:Parseff.capture} without [~release:true]) raises [Invalid_argument]. See
{!Parseff.many_iter} for the complete callback and sealing rules.

{@ocaml[
let sum_ints input =
  let total = ref 0 in
  let r =
    Parseff.parse input (fun () ->
        Parseff.sep_by_iter Parseff.integer (fun () -> Parseff.char ',')
          (fun n -> total := !total + n))
  in
  Result.map (fun () -> !total) r
]}

{1 Operator chains and expressions}

{2 [fold_left] and [fold_right]}

{!val:Parseff.fold_left} and {!val:Parseff.fold_right} parse one or more
elements separated by an operator parser returning a combine function, folding
left- or right-associatively. Pass [~otherwise] to return a default when the
first element fails (later failures after [commit]/[cut] still fail). Both stop
if an operator and element together consume no input.

{@ocaml skip[
val fold_left : ?otherwise:'a -> (unit -> 'a) -> (unit -> 'a -> 'a -> 'a) -> 'a
val fold_right : ?otherwise:'a -> (unit -> 'a) -> (unit -> 'a -> 'a -> 'a) -> 'a
]}

{@ocaml[
let subtraction () =
  Parseff.fold_left ~otherwise:0
    (fun () -> Char.code (Parseff.digit ()) - Char.code '0')
    (fun () ->
      let _ = Parseff.char '-' in
      ( - ))

let power () =
  Parseff.fold_right
    (fun () -> Char.code (Parseff.digit ()) - Char.code '0')
    (fun () ->
      let _ = Parseff.char '^' in
      fun a b -> int_of_float (float_of_int a ** float_of_int b))
]}

{2 [expression] and [precedence]}

{!val:Parseff.expression} parses expressions from a precedence table ordered
from lowest to highest precedence, supporting {!val:Parseff.infix_left},
{!val:Parseff.infix_right}, {!val:Parseff.prefix}, and {!val:Parseff.postfix}.
Use [expression] when operators are parsed by token parsers that may share
prefixes, play multiple roles, or should appear in [Expected] errors.

{!val:Parseff.precedence} uses a single [~operator] lookup function per operand
returning [Some (prec, op)] or [None]. It supports infix and postfix operators
(parse prefix operators in [operand] with [precedence ~min] inside
{!val:Parseff.rec_}) and is faster for grammars with many precedence levels
that can dispatch from {!val:Parseff.peek_char} or a lexer token.

{@ocaml skip[
val expression :
  operand:(unit -> 'a) ->
  ('a, [< `Infix | `Prefix | `Postfix ]) operator list list ->
  'a

val precedence :
  ?min:int ->
  operator:(unit -> (int * ('a, [< `Infix | `Postfix ]) operator) option) ->
  (unit -> 'a) ->
  'a
]}

See the {{!page-"expression-parser"}Expressions with precedence} guide for
complete examples.

{1 Complete example: JSON integer array}

{@ocaml[
let json_array () =
  let _ = Parseff.char '[' in
  Parseff.skip_whitespace ();
  let values =
    Parseff.sep_by
      (fun () ->
        Parseff.skip_whitespace ();
        let n = Parseff.integer () in
        Parseff.skip_whitespace ();
        n)
      (fun () -> Parseff.char ',')
  in
  Parseff.skip_whitespace ();
  let _ = Parseff.char ']' in
  values

let () =
  match Parseff.parse "[1, -2, 3]" json_array with
  | Ok nums -> Printf.printf "Sum: %d\n" (List.fold_left ( + ) 0 nums)
  | Error e -> prerr_endline (Parseff.render_error ~name:"array" e)
]}
