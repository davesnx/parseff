---
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';

const version = __DOCS_VERSION__;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<select
	class="version-select"
	aria-label="Documentation version"
	data-version={version}
	data-base={base}
>
	<option value={version} selected>{version}</option>
</select>
<ThemeSelect><slot /></ThemeSelect>

<script>
	const root = __DOCS_ROOT__;
	const selects = document.querySelectorAll<HTMLSelectElement>('.version-select');

	type Entry = { version: string; path: string; label: string };

	async function load(selects: NodeListOf<HTMLSelectElement>) {
		const { version: current, base = '' } = selects[0].dataset;
		const response = await fetch(`${root}/versions.json`);
		if (!response.ok) return;
		const entries: Entry[] = await response.json();
		for (const select of selects) {
			select.replaceChildren(
				...entries.map((entry) => new Option(entry.label, entry.version, false, entry.version === current)),
			);
			select.addEventListener('change', async () => {
				const target = entries.find((entry) => entry.version === select.value);
				if (!target) return;
				const versionRoot = `${root}/${target.path}`;
				const rest = location.pathname.startsWith(`${base}/`)
					? location.pathname.slice(base.length + 1)
					: '';
				if (versionRoot === `${base}/`) return;
				const page = `${versionRoot}${rest}${location.search}${location.hash}`;
				const exists = await fetch(`${versionRoot}${rest}`, { method: 'HEAD' }).then(
					(r) => r.ok,
					() => false,
				);
				location.href = exists ? page : versionRoot;
			});
		}
	}

	if (selects.length) load(selects).catch((error) => console.error('Could not load the version list', error));
</script>

<style>
	.version-select {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: transparent;
		color: var(--sl-color-gray-1);
		font: inherit;
		font-size: var(--sl-text-sm);
		padding: 0.25rem 0.5rem;
	}
</style>
