---
const channel = process.env.DOCS_CHANNEL ?? 'latest';
const version = process.env.DOCS_VERSION ?? 'main';
---

{
	channel !== 'latest' && (
		<div class="version-banner" data-pagefind-ignore>
			{channel === 'unreleased'
				? 'This is the documentation for the unreleased main branch. '
				: `This is the documentation for an old version (${version}). `}
			<a href="/parseff/">Go to the latest version.</a>
		</div>
	)
}

<style>
	.version-banner {
		background: var(--sl-color-orange-low);
		color: var(--sl-color-orange-high);
		padding: 0.5rem var(--sl-content-pad-x);
		text-align: center;
		font-size: var(--sl-text-sm);
	}
	.version-banner a {
		color: inherit;
		text-decoration: underline;
	}
</style>
