(rule
 (alias generate-markdown)
 (enabled_if
  (= %{env:PARSEFF_GENERATE_MARKDOWN=false} "true"))
 (mode
  (promote (until-clean)))
 (deps %{workspace_root}/_doc/_markdown/parseff/primitives.md)
 (targets primitives.md)
 (action
  (system
   "printf '%s\\n' '---' 'title: Primitives' 'description: Basic parsing operations in Parseff' '---' '' '<!-- This file is generated from doc/primitives.mld. Do not edit directly. -->' '' > %{targets} && cat %{workspace_root}/_doc/_markdown/parseff/primitives.md >> %{targets}")))

