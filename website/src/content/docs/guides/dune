(rule
 (alias generate-markdown)
 (enabled_if
  (= %{env:PARSEFF_GENERATE_MARKDOWN=false} "true"))
 (mode
  (promote (until-clean)))
 (deps %{workspace_root}/_doc/_markdown/parseff/first-parser.md)
 (targets first-parser.md)
 (action
  (system
   "printf '%s\\n' '---' 'title: Your first parser' 'description: Build a config file parser from scratch' '---' '' > %{targets} && cat %{workspace_root}/_doc/_markdown/parseff/first-parser.md >> %{targets}")))

