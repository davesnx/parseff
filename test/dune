(test
 (name test_fold_right_limit)
 (modules test_fold_right_limit)
 (libraries parseff alcotest)
 (action
  (setenv
   OCAMLRUNPARAM
   l=1M
   (run %{test}))))

; Rerun the streaming suites with each read buffer size.

(rule
 (alias runtest)
 (action
  (chdir
   buf_size_1
   (setenv
    PARSEFF_TEST_BUF_SIZE
    1
    (progn
     (run %{dep:test_streaming.exe} --compact)
     (run %{dep:test_streaming_robust.exe} --compact)
     (run %{dep:test_source_each.exe} --compact)
     (run %{dep:test_differential.exe} --compact)
     (run %{dep:test_protocol.exe} --compact)
     (run %{dep:test_iter.exe} --compact)
     (run %{dep:test_until.exe} --compact)
     (run %{dep:test_charset.exe} --compact))))))

(rule
